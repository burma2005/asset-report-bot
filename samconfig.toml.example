version = 0.1

[default.deploy.parameters]
stack_name = "asset-report-bot"
region = "ap-northeast-1"
confirm_changeset = false
capabilities = "CAPABILITY_IAM"
resolve_s3 = true
# GoogleClientIdParam：Google Cloud Console 建立 OAuth 2.0 Client ID（Web application）
# AdminEmailParam：管理員 email（無限額度 + 付費兜底）
# OpenRouterKeyParam：到 https://openrouter.ai/keys 申請（sk-or-... 開頭）
parameter_overrides = "OpenRouterKeyParam=<你的OpenRouter金鑰> GoogleClientIdParam=<你的Google-Client-ID>.apps.googleusercontent.com AdminEmailParam=<你的email>"
